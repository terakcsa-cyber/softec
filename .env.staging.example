# Staging template (pre-production). Generate with `pnpm deploy:staging:init`.
# Isolated Docker volumes from production. Default web port: 3080.

WEB_PUBLISHED_PORT=3080
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3080
DEPLOY_ENV=staging

POSTGRES_USER=vuln
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=vuln_intel_staging
RABBITMQ_DEFAULT_USER=vuln
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=/

DATABASE_URL=postgres://vuln:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/vuln_intel_staging
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://vuln:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@rabbitmq:5672/%2F

NODE_ENV=production
PORT=4001
API_HOST=0.0.0.0
WEB_PORT=3000
WEB_HOST=0.0.0.0
UPSTREAM_API_BASE=http://api:4001/api
API_CORS_ORIGIN=http://127.0.0.1:3080

JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
AUTH_ALLOW_REGISTER=true
AUTH_ALLOW_REGISTER_IN_PRODUCTION=false
AUTH_TOTP_ISSUER=VulnIntel-Staging
ALLOW_INTERNAL_API_BEARER=false
ADMIN_EMAILS=admin@example.com

METRICS_ENABLED=true
METRICS_POLL_QUEUES=true
RECONCILE_ENABLED=true
RECONCILE_STALE_HOURS=12

NVD_API_KEY=
NVD_POLL_INTERVAL_MS=900000
NVD_FANOUT_ENRICH=true
NVD_FANOUT_SCORE_HOT_ONLY=true
BDU_INGEST_ENABLED=false
BDU_ALLOW_MIRROR_FALLBACK=true
FSTEC_TG_CHANNEL=bdufstecru

LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROMPT_VERSION=v1
AI_ENRICH_REDIS_CACHE=true
DLQ_BOOT_RETRY=false

ASV_NUCLEI_ENABLED=0
MSF_ENABLED=0
