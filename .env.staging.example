# Staging template (pre-production). Generate with `pnpm deploy:staging:init`.
# Isolated Docker volumes from production. Default web port: 3080.

WEB_PUBLISHED_PORT=3080
# HTTPS via tls-proxy (Settings → Веб / TLS). Staging default 8443.
WEB_TLS_PUBLISHED_PORT=8443
WEB_TLS_HTTP_PORT=8080
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3080
# TLS_DOMAIN=127.0.0.1
# Bare IP HTTPS: Settings → Веб / TLS → «HTTPS для IP (самоподписанный)» (SAN IP, no DNS). Browser warning expected.
# Staging HTTP port is 8080 by default — Let's Encrypt HTTP-01 needs public :80 on the real hostname or public IP.
# For LE tests on staging, publish 80 and set a real DNS name (or IP + certbot≥5.4) + LETSENCRYPT_STAGING=true.
# LETSENCRYPT_STAGING=true
LETSENCRYPT_AUTO_RENEW=true
# LETSENCRYPT_IP_RENEW_DAYS=2
DEPLOY_ENV=staging

POSTGRES_USER=vuln
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=vuln_intel_staging
RABBITMQ_DEFAULT_USER=vuln
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=/

DATABASE_URL=postgres://vuln:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/vuln_intel_staging
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://vuln:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@rabbitmq:5672/%2F

NODE_ENV=production
PORT=4001
API_HOST=0.0.0.0
WEB_PORT=3000
WEB_HOST=0.0.0.0
UPSTREAM_API_BASE=http://api:4001/api
API_CORS_ORIGIN=http://127.0.0.1:3080

JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
AUTH_ALLOW_REGISTER=true
AUTH_ALLOW_REGISTER_IN_PRODUCTION=false
AUTH_TOTP_ISSUER=VulnIntel-Staging
ALLOW_INTERNAL_API_BEARER=false
ADMIN_EMAILS=admin@example.com

METRICS_ENABLED=true
METRICS_POLL_QUEUES=true
RECONCILE_ENABLED=true
RECONCILE_STALE_HOURS=12

NVD_API_KEY=
NVD_POLL_INTERVAL_MS=900000
# LLM mass fanout off; baseline/translate maturity runs in background when TEXT_ENGINE_BG_ENRICH=true.
# (baseline also backfills older CVEs; translate backlog needs BACKLOG_AI_SWEEP=true)
NVD_FANOUT_ENRICH=false
TEXT_ENGINE_BG_ENRICH=true
NVD_FANOUT_SCORE_HOT_ONLY=true
BDU_INGEST_ENABLED=false
BDU_ALLOW_MIRROR_FALLBACK=true
FSTEC_TG_CHANNEL=bdufstecru

TEXT_ENGINE=translate
LIBRETRANSLATE_URL=http://libretranslate:5000
TEXT_TRANSLATE_TIMEOUT_MS=15000

LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROMPT_VERSION=v1
AI_ENRICH_REDIS_CACHE=true
HOT24_AI_SWEEP=false
HOT24_AI_SWEEP_ON_START_MS=0
BACKLOG_AI_SWEEP=false
# ai.score off while TEXT_ENGINE=translate (enable with TEXT_ENGINE=llm or AI_SCORE_ENABLED=true)
DLQ_BOOT_RETRY=false

# EPSS
EPSS_BOOT_ON_START=true
EPSS_POLL_INTERVAL_MS=21600000
EPSS_FETCH_RETRIES=5

# Platform updates (Settings → Обновления)
# PLATFORM_UPDATE_REPO_URL=
# PLATFORM_UPDATE_BRANCH=main
PLATFORM_UPDATE_APPLY_ENABLED=false
# PLATFORM_HOST_REPO_PATH=/opt/vuln-intel-platform
# PLATFORM_UPDATE_BACKUP_KEEP=3
# DISK_HOUSEKEEPING=false

