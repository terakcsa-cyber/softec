# Production template for Linux + Docker Compose.
# Generate `.env.production` with `pnpm deploy:init` or copy this file manually. Keep real env files out of git.

# Public web endpoint
WEB_PUBLISHED_PORT=3000
# HTTPS via built-in Caddy tls-proxy (Settings → Веб / TLS). Default 443.
WEB_TLS_PUBLISHED_PORT=443
# Optional HTTP→HTTPS redirect publish (tls-proxy :80). Set empty/omit carefully on busy hosts.
WEB_TLS_HTTP_PORT=80
PUBLIC_WEB_ORIGIN=https://vuln-intel.example.com
# Optional CN override for TLS UI / Let's Encrypt (defaults to PUBLIC_WEB_ORIGIN host)
# TLS_DOMAIN=vuln-intel.example.com
# Bare IP without DNS (self-signed primary in UI): TLS_DOMAIN=203.0.113.10
# Let's Encrypt (domain): needs public DNS A/AAAA → this host and WEB_TLS_HTTP_PORT=80 reachable from the internet.
# Let's Encrypt (IP, optional): certbot≥5.4, public :80, shortlived ~6 days — no DNS required.
# Compose mounts ACME webroot + certbot config; optional staging CA for dry-runs:
# LETSENCRYPT_STAGING=false
# Auto-renew when days remaining < LETSENCRYPT_RENEW_DAYS (API process schedule):
LETSENCRYPT_AUTO_RENEW=true
# LETSENCRYPT_RENEW_DAYS=30
# LETSENCRYPT_IP_RENEW_DAYS=2

# Postgres / Redis / RabbitMQ Docker service credentials
POSTGRES_USER=vuln
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=vuln_intel
RABBITMQ_DEFAULT_USER=vuln
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=/

# App service URLs inside Docker network
DATABASE_URL=postgres://vuln:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/vuln_intel
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://vuln:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@rabbitmq:5672/%2F

# API / Web
NODE_ENV=production
PORT=4001
API_HOST=0.0.0.0
WEB_PORT=3000
WEB_HOST=0.0.0.0
UPSTREAM_API_BASE=http://api:4001/api
# Direct browser calls are not required; UI normally talks to Next BFF under /api.
# If you intentionally expose Nest API, set this to its public URL and configure API_CORS_ORIGIN.
# NEXT_PUBLIC_API_BASE=https://api.vuln-intel.example.com/api
API_CORS_ORIGIN=https://vuln-intel.example.com

# Authentication
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
# Optional: access JWT TTL seconds (default 3600). Was 900 — caused periodic summary 401.
# JWT_ACCESS_TTL_SEC=3600
# JWT_REFRESH_REUSE_GRACE_MS=30000
# First deploy default: open the web UI and create the first admin from /login.
# Optional headless fallback: uncomment both values to auto-create the first user if auth_user is empty.
# AUTH_BOOTSTRAP_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_LONG_BOOTSTRAP_PASSWORD
AUTH_ALLOW_REGISTER=false
# Emergency-only override; keep false for normal production.
AUTH_ALLOW_REGISTER_IN_PRODUCTION=false
AUTH_TOTP_ISSUER=VulnIntel
# Keep disabled unless you have a private trusted service-to-service path.
ALLOW_INTERNAL_API_BEARER=false
# Optional, only if ALLOW_INTERNAL_API_BEARER=true.
# INTERNAL_API_BEARER=

# NVD / BDU / FSTEC ingest
NVD_API_KEY=
NVD_POLL_INTERVAL_MS=900000
NVD_PAGE_SLEEP_MS=6500
# LLM mass fanout off (NVD_FANOUT_ENRICH=false is respected for translate/baseline too).
# Hot24 maturity still runs under TEXT_ENGINE_BG_ENRICH; inflight coalesce + AI_ENRICH_MAX_DEPTH prevent floods.
# (translate backlog needs BACKLOG_AI_SWEEP=true)
NVD_FANOUT_ENRICH=false
TEXT_ENGINE_BG_ENRICH=true
NVD_FANOUT_SCORE_HOT_ONLY=true
NVD_PUB_HOT_SYNC=true
BDU_INGEST_ENABLED=true
BDU_XML_URL=https://bdu.fstec.ru/files/documents/vulxml.zip
BDU_ALLOW_MIRROR_FALLBACK=true
# Enable if the host cannot validate bdu.fstec.ru TLS (common on non-RU VPS).
# Without this, ingest falls back to the GitHub mirror (may lag).
# BDU_TLS_INSECURE=1
BDU_POLL_INTERVAL_MS=1800000
BDU_INITIAL_DELAY_MS=20000
BDU_FETCH_TIMEOUT_MS=600000
# BDU_STAGING_DIR=/tmp/vuln-intel-bdu
# BDU_KEEP_STAGING=false
BDU_UPSERT_CHUNK=250
FSTEC_TG_CHANNEL=bdufstecru
FSTEC_FETCH_TIMEOUT_MS=25000

# Text engine / LLM enrichment
# baseline keeps enrichment local; set llm to use the LLM_* profile.
TEXT_ENGINE=translate
LIBRETRANSLATE_URL=http://libretranslate:5000
TEXT_TRANSLATE_TIMEOUT_MS=15000
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
XAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROMPT_VERSION=v1
LLM_TIMEOUT_MS=300000
LLM_HTTP_RETRIES=2
LLM_RAW_MAX_CHARS=8000
AI_ENRICH_REDIS_CACHE=true
AI_ENRICH_PREFETCH=10
# Soft cap on ai.enrich depth (ingest skips publish when at/above; 0 = unlimited)
AI_ENRICH_MAX_DEPTH=2000
AI_ENRICH_INFLIGHT_TTL_HOURS=6
# Card text maturity: baseline/translate write enrichment_ai inline (no Rabbit).
# AI_ENRICH_VIA_QUEUE=true
AI_ENRICH_INLINE_CONCURRENCY=32
# Unified risk score (deterministic). Default on; set false only to pause scoring.
AI_SCORE_ENABLED=true
# Default: write risk_score inline in ingest/API (no Rabbit). Legacy queue:
# AI_SCORE_VIA_QUEUE=true
AI_SCORE_INLINE_CONCURRENCY=48
# Full-corpus catch-up for CVE missing risk_score (background, default on)
BACKLOG_SCORE_SWEEP=true
BACKLOG_SCORE_SWEEP_LIMIT=2500
BACKLOG_SCORE_SWEEP_ON_START_MS=6000
BACKLOG_SCORE_SWEEP_INTERVAL_MS=12000
PG_POOL_MAX=16
HOT24_AI_SWEEP=false
HOT24_AI_SWEEP_LIMIT=1500
HOT24_AI_SWEEP_ON_START_MS=0
HOT24_AI_SWEEP_INTERVAL_MS=0
# Card backlog (older than 24h): on for baseline/translate unless false. Inline local RU.
# BACKLOG_AI_SWEEP=false
BACKLOG_AI_SWEEP_LIMIT=2500
AI_ENRICH_QUEUE_PUBLISHED_MAX_AGE_HOURS=24
HOT24_SCORE_SWEEP_LIMIT=500
HOT24_SCORE_STALE_HOURS=6
# HOT24_SCORE_BOOT=true
DLQ_BOOT_RETRY=false

# Postgres disk: prune + VACUUM ANALYZE (API; manual: pnpm pg:maint)
# PG_MAINTENANCE=false
# AUDIT_LOG_RETENTION_DAYS=90
# ENRICHMENT_AI_KEEP_PER_CVE=2
# REFRESH_TOKEN_RETENTION_DAYS=14
# Idle AI process exits by default; keep metrics process: AI_KEEP_IDLE_PROCESS=true

# MaxPatrol VM integration is configured in the UI.
MPVM_HTTP_TIMEOUT_MS=90000
MPVM_SYNC_MAX_ROWS=50000

# Telegram integration is configured in the UI.

# EPSS (FIRST + Cyentia CSV.gz failover; daily job + boot if empty/stale)
EPSS_BOOT_ON_START=true
EPSS_POLL_INTERVAL_MS=86400000
EPSS_FETCH_TIMEOUT_MS=180000
EPSS_FETCH_RETRIES=5
EPSS_FAIL_RETRY_MS=300000
# EPSS_FEED_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz

# Platform updates (Settings → Обновления).
# Prod compose mounts the git checkout at /host-repo + docker.sock automatically.
# deploy.sh fills HOST path / REPO_URL from the local git remote when missing.
# PLATFORM_UPDATE_REPO_URL=https://github.com/OWNER/vuln-intel-platform.git
PLATFORM_UPDATE_BRANCH=main
PLATFORM_UPDATE_APPLY_ENABLED=true
# PLATFORM_HOST_REPO_PATH=/opt/vuln-intel-platform
# PLATFORM_UPDATE_BACKUP=true
# PLATFORM_UPDATE_BACKUP_KEEP=3   # UI cleanup keeps N newest backups/*.sql.gz
# PLATFORM_GIT_SHA=  # baked by deploy.sh / image build
