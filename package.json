{
  "name": "vuln-intel-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:fast": "DEV_SKIP_NEXT_CLEAN=1 node --env-file=.env scripts/dev.mjs",
    "clean:web": "node scripts/clean-web-next-cache.mjs",
    "dlq:replay:score": "node scripts/replay-dlq-score.mjs",
    "rescore:all": "node scripts/rescore-all.mjs",
    "nvd:backfill": "node --env-file=.env scripts/nvd-backfill.mjs",
    "nvd:pub-catchup": "node --env-file=.env scripts/nvd-pub-catchup-now.mjs",
    "vulncheck:kev-ingest": "node --env-file=.env scripts/vulncheck-kev-ingest-now.mjs",
    "epss:sync": "node --env-file=.env scripts/epss-sync-now.mjs",
    "rescore:hot24": "node --env-file=.env scripts/rescore-hot24-now.mjs",
    "bdu:sync": "node --env-file=.env scripts/bdu-sync-now.mjs",
    "ai:bulk-enrich": "node --env-file=.env scripts/ai-bulk-enrich.mjs",
    "enrichment:repair": "node --env-file=.env scripts/enrichment-repair-all.mjs",
    "build": "turbo build",
    "test": "pnpm --filter @vuln-intel/shared build && node --test packages/shared/test/core.test.mjs packages/shared/test/roles.test.mjs packages/shared/test/dlq.test.mjs packages/shared/test/queue.test.mjs packages/shared/test/security-policy.test.mjs packages/shared/test/prometheus.test.mjs packages/shared/test/epss-ingest.test.mjs && node scripts/check-coverage.mjs",
    "test:unit": "pnpm --filter @vuln-intel/shared build && node --test packages/shared/test/core.test.mjs packages/shared/test/roles.test.mjs packages/shared/test/dlq.test.mjs packages/shared/test/queue.test.mjs packages/shared/test/security-policy.test.mjs packages/shared/test/prometheus.test.mjs packages/shared/test/epss-ingest.test.mjs",
    "test:integration": "pnpm --filter @vuln-intel/shared build && node --test packages/shared/test/integration-containers.test.mjs packages/shared/test/integration-chaos.test.mjs",
    "audit:high": "node scripts/check-audit.mjs",
    "test:e2e": "pnpm --filter @vuln-intel/web e2e",
    "migrate": "node --env-file=.env scripts/run-migrations.mjs",
    "smoke:post-deploy": "node scripts/post-deploy-smoke.mjs",
    "smoke:integration": "node scripts/integration-api-smoke.mjs",
    "backup:pg": "bash scripts/pg-backup.sh",
    "update:platform": "bash scripts/platform-update.sh",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier -w .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:stop": "docker compose -f infra/docker-compose.yml stop",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:wipe": "docker compose -f infra/docker-compose.yml down -v",
    "deploy:init": "node scripts/init-production-env.mjs",
    "deploy:staging:init": "node scripts/init-staging-env.mjs",
    "deploy:staging": "./deploy.sh --staging",
    "deploy:config": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml config",
    "deploy:up": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml up -d --build",
    "deploy:logs": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml logs -f api web ingest ai",
    "deploy": "./deploy.sh",
    "security:sast": "node scripts/security-sast.mjs",
    "security:dast": "node scripts/security-dast.mjs"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "undici": ">=6.27.0",
      "tmp": ">=0.2.6",
      "multer": ">=2.2.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/rabbitmq": "^10.28.0",
    "amqplib": "^0.10.9",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "uuid": "^11.1.0"
  }
}
